{
  "name": "ai-chat-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta npm:dev:backend npm:dev:frontend",
    "dev:backend": "node --env-file-if-exists=.env.local --import tsx backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts frontend",
    "build": "vite build --config frontend/vite.config.ts frontend",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "fastify": "5.11.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  }
}
